{
  "catalog_version": "1.0.0",
  "dataset_version": "synthetic-active-customers-v1",
  "evaluation_as_of_utc": "2026-10-21T02:00:00Z",
  "metrics": [
    {
      "metric_id": "product.active_customers_login_30d",
      "name": "Clientes con login en 30 días",
      "owner": "Producto",
      "version": "1.0.0",
      "synonyms": ["clientes activos", "usuarios activos", "activos de producto"],
      "definition": "Clientes distintos con al menos un login dentro de la ventana UTC.",
      "grain": "customer_id",
      "time": {"kind": "half_open_window", "timezone": "UTC", "start_inclusive": "2026-09-21T00:00:00Z", "end_exclusive": "2026-10-21T00:00:00Z", "days": 30},
      "freshness": {"data_current_through_utc": "2026-10-21T00:00:00Z", "loaded_at_utc": "2026-10-21T00:10:00Z", "max_age_hours": 24, "note": "Metadatos fijos sintéticos; no verifica una ingesta real."},
      "lineage": {"file": "data.sql", "table": "logins", "columns": ["customer_id", "occurred_at"], "filter": "start <= occurred_at < end", "aggregation": "COUNT(DISTINCT customer_id)"}
    },
    {
      "metric_id": "business.active_customers_transaction_30d",
      "name": "Clientes con transacción monetaria contabilizada en 30 días",
      "owner": "Negocio",
      "version": "1.0.0",
      "synonyms": ["clientes activos", "clientes transaccionales", "activos de negocio"],
      "definition": "Clientes distintos con >=1 transacción posted y amount_cents != 0 dentro de la ventana. Un reembolso negativo posted sí cuenta. Se excluyen importes cero y estados reversed o pending. No se netean importes por cliente.",
      "grain": "customer_id",
      "time": {"kind": "half_open_window", "timezone": "UTC", "start_inclusive": "2026-09-21T00:00:00Z", "end_exclusive": "2026-10-21T00:00:00Z", "days": 30},
      "freshness": {"data_current_through_utc": "2026-10-21T00:00:00Z", "loaded_at_utc": "2026-10-21T00:20:00Z", "max_age_hours": 24, "note": "Metadatos fijos sintéticos; no verifica una ingesta real."},
      "lineage": {"file": "data.sql", "table": "transactions", "columns": ["customer_id", "occurred_at", "amount_cents", "status"], "filter": "start <= occurred_at < end AND status = 'posted' AND amount_cents != 0", "aggregation": "COUNT(DISTINCT customer_id)"}
    },
    {
      "metric_id": "finance.active_customers_positive_balance_close",
      "name": "Clientes con saldo positivo al cierre",
      "owner": "Finanzas",
      "version": "1.0.0",
      "synonyms": ["clientes activos", "clientes con saldo", "activos de finanzas"],
      "definition": "Clientes distintos con saldo estrictamente positivo en el snapshot completo del cierre UTC del 2026-10-20. Es un stock al cierre, no una actividad en 30 días.",
      "grain": "customer_id at snapshot_date",
      "time": {"kind": "closing_snapshot", "timezone": "UTC", "snapshot_date": "2026-10-20", "close_exclusive_utc": "2026-10-21T00:00:00Z"},
      "freshness": {"data_current_through_utc": "2026-10-21T00:00:00Z", "loaded_at_utc": "2026-10-21T01:00:00Z", "max_age_hours": 24, "note": "Metadatos fijos sintéticos; no verifica una ingesta real."},
      "lineage": {"file": "data.sql", "table": "balances", "columns": ["customer_id", "snapshot_date", "balance_cents"], "filter": "snapshot_date = '2026-10-20' AND balance_cents > 0", "aggregation": "COUNT(DISTINCT customer_id)"}
    }
  ]
}
